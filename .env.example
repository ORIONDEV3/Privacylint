# GEMINI_API_KEY: Required for optional AI explanations and bounded code remediation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL / Supabase connection string for persistent storage
DATABASE_URL="postgresql://privacylint_app:REDACTED@db.supabase.co:5432/privacylint?sslmode=require"

# SESSION_SECRET: High-entropy secret for signing HttpOnly session tokens
SESSION_SECRET="replace-with-64-byte-hex-secret-in-production"

# CORS_ALLOWED_ORIGINS: Comma-separated allowlist of origins
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# RATE_LIMIT_MAX_REQUESTS: Max API requests per 15-minute window
RATE_LIMIT_MAX_REQUESTS="120"

